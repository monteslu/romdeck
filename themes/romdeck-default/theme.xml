<?xml version="1.0"?>
<!--
  romdeck default theme — "Shelf"

  A coffee-table-book layout: the art is the interface, chrome gets out of
  the way. Cover art is large and centred, metadata is small and quiet, and
  there is a lot of empty space on purpose.

  Authored in the ES-DE theme format because romdeck's theme engine is a
  reimplementation of EmulationStation/ES-DE, and this theme is its dogfood.
  Everything here is portable vocabulary — normalized 0-1 positions,
  ${variables}, variants and colorSchemes.

  FIRST-PARTY AND DELIBERATELY LIGHT. The community art-book themes are
  20-220 MB of artwork under CC-BY-NC-SA; this is a few KB of XML under
  romdeck's own licence, so a fresh install is never blank and never
  encumbered. For the real thing, the theme picker downloads Art Book Next.
-->
<theme>
    <variables>
        <bg>0d0f14</bg>
        <panel>1a1f2b</panel>
        <ink>e8ecf4</ink>
        <dim>8b94a7</dim>
        <accent>4fd1c5</accent>
    </variables>

    <variables colorScheme="amber">
        <bg>140f08</bg>
        <panel>241a0d</panel>
        <ink>ffd79a</ink>
        <dim>a4794a</dim>
        <accent>f6ad55</accent>
    </variables>

    <!-- A light scheme, because an art book is usually printed on paper. -->
    <variables colorScheme="paper">
        <bg>f4f1ea</bg>
        <panel>e4dfd3</panel>
        <ink>1e1c18</ink>
        <dim>6b655a</dim>
        <accent>b4553a</accent>
    </variables>

    <!--
      Desktop view (romdeck extension).

      ES-DE's format has no windowed/mouse view, so romdeck adds one. It is
      OPTIONAL: any ES-DE theme without this block still restyles the desktop,
      because romdeck maps conventionally-named theme variables (bg, text,
      accent, selectedColor, …) onto the same tokens. This block just makes
      the intent explicit.
    -->
    <view name="desktop">
        <text name="bg"><color>${bg}</color></text>
        <text name="bg2"><color>${panel}</color></text>
        <text name="panel"><color>${panel}</color></text>
        <text name="line"><color>262d3d</color></text>
        <text name="ink"><color>${ink}</color></text>
        <text name="dim"><color>${dim}</color></text>
        <text name="accent"><color>${accent}</color></text>
        <text name="accent2"><color>f6ad55</color></text>
        <text name="danger"><color>fc8181</color></text>
        <!-- Bigger tiles than a conventional grid: art-forward here too. -->
        <grid name="grid">
            <itemSize>190 0</itemSize>
        </grid>
    </view>

    <view name="desktop" colorScheme="amber">
        <text name="line"><color>3a2a14</color></text>
        <text name="accent2"><color>ffd79a</color></text>
    </view>

    <view name="desktop" colorScheme="paper">
        <text name="line"><color>d0c9ba</color></text>
        <text name="accent2"><color>7a6a52</color></text>
        <text name="danger"><color>a33a2a</color></text>
    </view>

    <!-- ══ system view ══════════════════════════════════════════════════
         One system at a time, large. The carousel fills the upper half so
         a system's logo (or its name, in a library without art) is the only
         thing competing for attention.                                     -->
    <view name="system">
        <image name="background">
            <pos>0 0</pos>
            <size>1 1</size>
            <color>${bg}</color>
            <zIndex>0</zIndex>
        </image>

        <!-- A hairline under the carousel: the only piece of chrome. -->
        <image name="rule">
            <pos>0.5 0.735</pos>
            <size>0.84 0.0015</size>
            <origin>0.5 0.5</origin>
            <color>${dim}</color>
            <opacity>0.35</opacity>
            <zIndex>15</zIndex>
        </image>

        <!-- Cards stay in the panel colour; the ACCENT marks the selection as
             a border rather than a fill, so a selected card without art isn't
             a flat slab of colour with text floating on it.

             staticImage points at Shelf's own wordmarks, tinted through
             <imageColor> — a system Shelf has no wordmark for falls back to
             _default, and then to its plain name, so a library full of
             unusual systems still reads. -->
        <carousel name="systemCarousel">
            <pos>0.5 0.42</pos>
            <size>0.94 0.46</size>
            <origin>0.5 0.5</origin>
            <color>${panel}</color>
            <selectedColor>${panel}</selectedColor>
            <selectorColor>${accent}</selectorColor>
            <textColor>${ink}</textColor>
            <staticImage>./logos/${system.theme}.svg</staticImage>
            <defaultImage>./logos/_default.svg</defaultImage>
            <imageColor>${dim}</imageColor>
            <imageSelectedColor>${ink}</imageSelectedColor>
            <itemScale>1.12</itemScale>
            <itemSpacing>0.025</itemSpacing>
            <maxItemCount>5</maxItemCount>
            <zIndex>20</zIndex>
        </carousel>

        <!-- Only the count is set below the rule. The system's NAME is already
             on the selected card, and printing it twice is the kind of thing
             that reads as a bug rather than as emphasis. A theme with system
             logos gets the name from the art; this one gets it from the card. -->
        <text name="gameCount">
            <pos>0.5 0.815</pos>
            <origin>0.5 0.5</origin>
            <metadata>system.gameCount</metadata>
            <color>${dim}</color>
            <fontSize>0.032</fontSize>
            <horizontalAlignment>center</horizontalAlignment>
            <zIndex>25</zIndex>
        </text>

        <text name="help">
            <pos>0.5 0.955</pos>
            <origin>0.5 0.5</origin>
            <text>← →  system      Ⓐ  open      Start  menu</text>
            <color>${dim}</color>
            <fontSize>0.024</fontSize>
            <opacity>0.7</opacity>
            <horizontalAlignment>center</horizontalAlignment>
            <zIndex>25</zIndex>
        </text>
    </view>

    <!-- ══ gamelist view ════════════════════════════════════════════════
         The plate: cover art dominates the right, the list is a narrow
         column on the left, and the caption sits beneath the art.          -->
    <view name="gamelist">
        <image name="background">
            <pos>0 0</pos>
            <size>1 1</size>
            <color>${bg}</color>
            <zIndex>0</zIndex>
        </image>

        <text name="systemHeader">
            <pos>0.06 0.075</pos>
            <origin>0 0.5</origin>
            <metadata>system.fullName</metadata>
            <color>${dim}</color>
            <fontSize>0.028</fontSize>
            <zIndex>10</zIndex>
        </text>

        <image name="headerRule">
            <pos>0.06 0.105</pos>
            <size>0.88 0.0015</size>
            <origin>0 0.5</origin>
            <color>${dim}</color>
            <opacity>0.3</opacity>
            <zIndex>10</zIndex>
        </image>

        <!-- No selector bar: the accent colour marks the selection instead,
             so the list reads as a table of contents rather than a menu. -->
        <textlist name="gamelist">
            <pos>0.06 0.15</pos>
            <size>0.34 0.72</size>
            <color>${dim}</color>
            <selectedColor>${accent}</selectedColor>
            <selectorColor>00000000</selectorColor>
            <fontSize>0.034</fontSize>
            <lineSpacing>1.75</lineSpacing>
            <zIndex>20</zIndex>
        </textlist>

        <!-- The plate. maxSize rather than size, so covers keep their
             aspect ratio instead of being stretched to a fixed box. -->
        <image name="md_cover">
            <pos>0.70 0.45</pos>
            <maxSize>0.44 0.56</maxSize>
            <origin>0.5 0.5</origin>
            <metadata>game.cover</metadata>
            <zIndex>20</zIndex>
        </image>

        <video name="md_video" variant="withVideo">
            <pos>0.70 0.45</pos>
            <maxSize>0.44 0.56</maxSize>
            <origin>0.5 0.5</origin>
            <metadata>game.video</metadata>
            <zIndex>21</zIndex>
        </video>

        <!-- Caption block, set like a book plate's. -->
        <text name="md_name">
            <pos>0.70 0.80</pos>
            <origin>0.5 0.5</origin>
            <metadata>game.name</metadata>
            <color>${ink}</color>
            <fontSize>0.036</fontSize>
            <horizontalAlignment>center</horizontalAlignment>
            <zIndex>25</zIndex>
        </text>

        <text name="md_detail">
            <pos>0.70 0.855</pos>
            <origin>0.5 0.5</origin>
            <metadata>game.detail</metadata>
            <color>${dim}</color>
            <fontSize>0.024</fontSize>
            <horizontalAlignment>center</horizontalAlignment>
            <zIndex>25</zIndex>
        </text>

        <text name="help">
            <pos>0.5 0.955</pos>
            <origin>0.5 0.5</origin>
            <text>↑ ↓  browse      Ⓐ  play      Ⓑ  back      Ⓧ  options</text>
            <color>${dim}</color>
            <fontSize>0.024</fontSize>
            <opacity>0.7</opacity>
            <horizontalAlignment>center</horizontalAlignment>
            <zIndex>25</zIndex>
        </text>
    </view>
</theme>
